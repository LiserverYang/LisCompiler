fn idg<T>(x: T) -> T
{
    ret x;
}

fn pickg<T>(a: T, b: T, take: bool) -> T
{
    if take
    {
        ret a;
    }
    ret b;
}

fn useg000(x: i32) -> i32
{
    let a = idg(x);
    let b = idg(1.5);
    let c = pickg(a, x + 1, true);
    let d = pickg(2.5, b, false);
    ret c + (d as i32);
}

