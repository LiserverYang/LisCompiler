{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lis",
  "scopeName": "source.lis",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#attributes"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lis",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lis",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lis",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lis",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.lis",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.lis",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.lis",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lis",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lis",
          "match": "\\b(if|else|while|for|in|match|ret|break|continue|as)\\b"
        },
        {
          "name": "keyword.other.lis",
          "match": "\\b(impt|struct|enum|trait|impl|fn|let|mut|pub|self|move)\\b"
        },
        {
          "name": "storage.type.lis",
          "match": "\\b(i8|i16|i32|i64|f32|f64|bool|char|void)\\b"
        },
        {
          "name": "constant.language.lis",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lis",
          "match": "==|!=|<=|>=|&&|\\|\\||->|=>|::|[+\\-*/%<>=&|!]"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.tag.lis",
          "match": "#\\[[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
