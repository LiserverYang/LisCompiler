{
  "name": "lis-lang",
  "displayName": "Lis Language Support",
  "description": "Lis language support: syntax highlighting, diagnostics, go-to-definition, hover and completion via the lisls language server.",
  "version": "0.1.0",
  "publisher": "liserve-yang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lis",
        "aliases": [
          "Lis",
          "lis"
        ],
        "extensions": [
          ".lis"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lis",
        "scopeName": "source.lis",
        "path": "./syntaxes/lis.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lis",
      "properties": {
        "lis-lang.lislsPath": {
          "type": "string",
          "default": "",
          "description": "Path to the lisls executable (empty = look for 'lisls' in PATH)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
