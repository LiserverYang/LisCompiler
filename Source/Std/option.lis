// option.lis
//
// A real optional-value type: a tagged union with `Some(T)` carrying the value
// and unit `None` for absence. It is the idiomatic way to represent a value
// that may be missing (a `null`-free "maybe"), and is what `Iterator<T>::next`
// returns to signal exhaustion.
//
//     let o = Option::Some(7);        // Some value
//     let e = Option::None;           // No value
//     match o { Some(v) => ..., None => ... }
//
// Constructed via the enum-variant syntax `Option::Some(x)` / `Option::None`;
// consumed via `match`, which must be exhaustive (both variants).

enum Option<T>
{
    Some(T),
    None
}

// True if `o` carries a value (`Some`).
//
//     if is_some(Option::Some(1)) { ... }
fn is_some<T>(o: Option<T>) -> bool
{
    match o {
        Some(_v) => { ret true; },
        None => { ret false; },
    }
}

// True if `o` is `None`.
fn is_none<T>(o: Option<T>) -> bool
{
    match o {
        Some(_v) => { ret false; },
        None => { ret true; },
    }
}

// Unwrap the `Some` payload, falling back to `dflt` on `None`. The safe
// alternative to `unwrap` (which needs a panic mechanism the language does
// not have yet).
//
//     unwrap_or(Option::Some(7), 0)  // 7
//     unwrap_or(Option::None, 0)     // 0
fn unwrap_or<T>(o: Option<T>, dflt: T) -> T
{
    match o {
        Some(v) => { ret v; },
        None => { ret dflt; },
    }
}

// `a` if it is `Some`, else `b`. Both are `Option<T>` (the payload of `a` is
// discarded when it is `Some`).
//
//     and(Option::Some(1), Option::Some(5))  // Some(5)
//     and(Option::None,    Option::Some(5))  // None
fn and<T>(a: Option<T>, b: Option<T>) -> Option<T>
{
    match a {
        Some(_v) => { ret b; },
        None => { ret Option::None; },
    }
}

// `a` if it is `Some`, else `b`. Unlike `and`, the payload of a `Some` is
// preserved.
//
//     or(Option::Some(1), Option::Some(9))  // Some(1)
//     or(Option::None,    Option::Some(9))  // Some(9)
fn or<T>(a: Option<T>, b: Option<T>) -> Option<T>
{
    match a {
        Some(v) => { ret Option::Some(v); },
        None => { ret b; },
    }
}
