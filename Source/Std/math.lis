//
// math.lis — numeric helpers + the operator-overload traits.
//
// The trait section defines the builtin operator traits. Primitives
// auto-implement them (the compiler seeds them when the trait is declared), so
// a generic `fn min<T: Numeric>` accepts i32/f64 and rejects structs; a struct
// opts in by implementing the specific operator trait (`impl Add for Vec2`).
//
//     - Numeric / Integer : marker traits for generic numeric bounds.
//     - Add ... Rem        : arithmetic,  `a + b` → `a.add(b)`.
//     - PartialEq/PartialOrd : `==` / `<`, return bool.
//     - BitAnd ... Shr     : bitwise / shifts (BitXor/Shl/Shr have no infix
//                            syntax — see the trait definitions below).
//
// The function section provides generic min/max/clamp (monomorphized per use
// site) plus integer helpers (gcd/lcm/ipow/...). abs/fabs are specialised to
// i32/f64 because the language has no unary negation — `0 - x` needs a concrete
// literal type.

// Marker trait: a numeric type (ints + floats + char). Primitives implement it
// automatically; structs cannot (it is primitives-only). Use as a generic
// bound for "any number": `fn clamp<T: Numeric>(...)`.
trait Numeric
{
}

// Marker trait: a type that may be COPIED (every primitive; structs, enums,
// String and Vec are not). Primitives implement it automatically, exactly like
// Numeric.
//
// It is not decoration: `T: Copy` is what makes a T-typed value readable
// through a reference inside a generic body. Without the bound the compiler
// classifies `ret self.v` (with `self: &Box`) as a MOVE out of a borrow and
// rejects it with E3017, so a container could not hand out its elements at all.
// Use it as the bound of any generic type that copies its elements:
//     struct Vec<T: Copy> { ... }
trait Copy
{
}

// Marker trait: an integer type (i8/i16/i32/i64). Primitives implement it
// automatically; floats and structs do not. Use for bitwise/shift generics.
trait Integer
{
}

// Arithmetic: `+ - * / %`. A struct implementing `Add` gets `a + b` lowered to
// `a.add(b)`. Primitives auto-implement all of these.
trait Add
{
    fn add(self, other: Self) -> Self;
}

trait Sub
{
    fn sub(self, other: Self) -> Self;
}

trait Mul
{
    fn mul(self, other: Self) -> Self;
}

trait Div
{
    fn div(self, other: Self) -> Self;
}

trait Rem
{
    fn rem(self, other: Self) -> Self;
}

// Equality: `==` (`eq`) and `!=` (`ne`), returning bool.
//
// The receiver AND the operand are REFERENCES. Comparing must not consume what
// it compares: with a by-value `self` a non-Copy type could not implement this
// at all, because `a == b` would MOVE both operands (that is why the stdlib
// String had no equality). Implementing it is therefore
// `fn eq(self: &Self, other: &Self) -> bool`, and `a == b` hands the operator
// borrows of both sides. The arithmetic traits stay by-value
// (`Add::add(self, rhs)`), matching Rust: `+` produces a new value and may well
// consume its operands.
trait PartialEq
{
    fn eq(self: &Self, other: &Self) -> bool;
    fn ne(self: &Self, other: &Self) -> bool;
}

// Ordering: `< > <= >=`, returning bool. Reference receivers, like PartialEq.
trait PartialOrd
{
    fn lt(self: &Self, other: &Self) -> bool;
    fn gt(self: &Self, other: &Self) -> bool;
    fn le(self: &Self, other: &Self) -> bool;
    fn ge(self: &Self, other: &Self) -> bool;
}

// TOTAL order (2026-09-20): a MARKER trait saying "every two keys compare, and
// they are never both-less and never both-greater" — the invariant a search tree
// needs. The ordered containers bound their key with it:
//
//     impl<K: Ord + PartialOrd, V> Map<K, V> { ... }
//
// It carries no `cmp` method on purpose: a method would have to be CALLED on
// key values, and this language cannot call a trait method on a primitive
// (`7.cmp(&8)` is "cannot call method on non-struct type 'int32'"). Comparison
// therefore goes through the `<` / `>` operators, which work for primitives and
// for a generic parameter bounded by PartialOrd.
//
// Primitives (ints/floats/char/bool) are seeded with it by the compiler, like
// Copy/Numeric; a struct opts in with an empty `impl Ord for T { }` and a real
// `impl PartialOrd for T` (String does exactly that).
trait Ord
{
}

// Bitwise: `& | ^`. Primitives (ints) auto-implement these.
trait BitAnd
{
    fn bitand(self, other: Self) -> Self;
}

trait BitOr
{
    fn bitor(self, other: Self) -> Self;
}

// `^`: infix XOR (2026-09-19). The lexer has a `^` token and the parser gives
// it a level between `&` and `|`, so `a ^ b` works for integer primitives and
// for a struct implementing this trait.
//
// KNOWN LIMITATION (P13, shifts only): `Shl` / `Shr` have NO infix syntax — the
// lexer has no `<<` / `>>` tokens, so `a << b` cannot be written. The traits are
// still useful: primitives auto-implement them and a generic bound `T: Shl`
// works, with the concrete method (`shl` / `shr`) callable directly. They exist
// so the compiler's operator-overload machinery stays complete; do not try to
// write `<<`/`>>` in source.
trait BitXor
{
    fn bitxor(self, other: Self) -> Self;
}

// Shifts: no `<<`/`>>` infix tokens (see above); `shl`/`shr` are callable
// methods and usable as generic bounds.
trait Shl
{
    fn shl(self, other: Self) -> Self;
}

trait Shr
{
    fn shr(self, other: Self) -> Self;
}

// The smaller of `a` and `b`. Generic over any numeric type (`T: Numeric`).
fn min<T: Numeric>(a: T, b: T) -> T
{
    if a < b {
        ret a;
    }
    ret b;
}

// The larger of `a` and `b`. Generic over any numeric type.
fn max<T: Numeric>(a: T, b: T) -> T
{
    if a > b {
        ret a;
    }
    ret b;
}

// Clamp `x` into the inclusive range [`lo`, `hi`]: `lo` if `x < lo`, `hi` if
// `x > hi`, else `x`. Generic over any numeric type.
fn clamp<T: Numeric>(x: T, lo: T, hi: T) -> T
{
    if x < lo {
        ret lo;
    }
    if x > hi {
        ret hi;
    }
    ret x;
}

// Absolute value of an i32 (`0 - x`, since the language has no unary minus).
fn abs(x: i32) -> i32
{
    if x < 0 {
        ret 0 - x;
    }
    ret x;
}

// Absolute value of an f64.
fn fabs(x: f64) -> f64
{
    if x < 0.0 {
        ret 0.0 - x;
    }
    ret x;
}

// Greatest common divisor of two i32s (Euclidean algorithm); always
// non-negative. `gcd(0, b) == b`.
//
//     gcd(12, 18)  // 6
fn gcd(a: i32, b: i32) -> i32
{
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    if x < 0 {
        ret 0 - x;
    }
    ret x;
}

// Least common multiple of two i32s; `0` if either is `0`. May overflow for
// large inputs (`(a / gcd) * b`).
//
//     lcm(4, 6)  // 12
fn lcm(a: i32, b: i32) -> i32
{
    if (a == 0) || (b == 0) {
        ret 0;
    }
    ret (a / gcd(a, b)) * b;
}

// Integer power `base ^ exp` (repeated multiplication). `exp` must be
// non-negative; `ipow(b, 0) == 1`. May overflow for large values.
//
//     ipow(2, 10)  // 1024
fn ipow(base: i32, exp: i32) -> i32
{
    let mut acc = 1;
    let mut k = 0;
    while k < exp {
        acc = acc * base;
        k = k + 1;
    }
    ret acc;
}

// True if `x` is divisible by 2. Correct for negative `x` too.
fn is_even(x: i32) -> bool
{
    ret (x % 2) == 0;
}

// True if `x` is not divisible by 2 (uses `!= 0`, so negatives count as odd).
fn is_odd(x: i32) -> bool
{
    ret (x % 2) != 0;
}

// Sign of `x`: `-1` for negative, `1` for positive, `0` for zero.
fn sign(x: i32) -> i32
{
    if x < 0 {
        ret 0 - 1;
    }
    if x > 0 {
        ret 1;
    }
    ret 0;
}

// Degrees → radians (`x * π/180`). For use with f64 trig later.
fn deg_to_rad(x: f64) -> f64
{
    ret x * 0.017453292519943295;
}

// Radians → degrees (`x * 180/π`).
fn rad_to_deg(x: f64) -> f64
{
    ret x * 57.29577951308232;
}

// Linear interpolation between `a` and `b` by factor `t` (0.0 → `a`, 1.0 → `b`).
fn lerp(a: f64, b: f64, t: f64) -> f64
{
    ret a + (b - a) * t;
}

// ─────────────────────────────────────────────────────────────────────────────
// 浮点数学（2026-09-26）
// ─────────────────────────────────────────────────────────────────────────────
//
// 纯 Lis，不依赖 libm（语言还没有 extern/FFI）。精度与 libm 同量级（相对误差
// ~1e-16）：
//   * sqrt             归一化到 [1, 4) + 牛顿迭代（二次收敛）
//   * floor/ceil/round 建立在 trunc 上（用到 f64 -> i64 的 cast）
//   * cos/sin/tan      区间归约 + 泰勒展开
//
// 全部按 f64 计算；floor/ceil/round/trunc 的定义域是 |x| < 2^63（超界的
// f64 -> i64 转换与 C 一样是未定义的）。

// 圆周率与它的两个常用倍数（全局初始化器必须是字面量，所以写成算好的常量）。
let PI: f64 = 3.141592653589793;
let TWO_PI: f64 = 6.283185307179586;
let HALF_PI: f64 = 1.5707963267948966;

// 向零截断（C 的 `(int)x`）。
fn trunc(x: f64) -> f64
{
    ret (x as i64) as f64;
}

// 向下取整（<= x 的最大整数）。
fn floor(x: f64) -> f64
{
    let t = trunc(x);
    if x < 0.0 && t != x {
        ret t - 1.0;
    }
    ret t;
}

// 向上取整（>= x 的最小整数）。
fn ceil(x: f64) -> f64
{
    let t = trunc(x);
    if x > 0.0 && t != x {
        ret t + 1.0;
    }
    ret t;
}

// 四舍五入；恰为 .5 时远离零（与 C 的 round 一致）。
fn round(x: f64) -> f64
{
    if x < 0.0 {
        ret 0.0 - floor((0.0 - x) + 0.5);
    }
    ret floor(x + 0.5);
}

// 小数部分（x - trunc(x)，符号跟随 x）。
fn fract(x: f64) -> f64
{
    ret x - trunc(x);
}

// 平方根。把 x 归一化到 [1, 4)（成对乘除 4，缩放因子同步成对乘除 2），于是
// 初值 1.0 与真值最多差一倍；牛顿迭代 r <- (r + y/r) / 2 每步平方误差，6 步
// 就到 1e-16 以下。缩放因子是 2 的幂，乘回去不丢精度。
fn sqrt(x: f64) -> f64
{
    if x < 0.0 {
        panic("sqrt of a negative number");
    }
    if x == 0.0 {
        ret 0.0;
    }

    let mut y = x;
    let mut scale = 1.0;
    while y >= 4.0
    {
        y = y / 4.0;
        scale = scale * 2.0;
    }
    while y < 1.0
    {
        y = y * 4.0;
        scale = scale / 2.0;
    }

    let mut r = 1.0;
    let mut i = 0;
    while i < 6
    {
        r = (r + y / r) * 0.5;
        i = i + 1;
    }
    ret r * scale;
}

// 把角度归约到 [0, 2*pi)：f64 的 % 是截断余数（frem），负的再加一个周期。
fn wrap2pi(x: f64) -> f64
{
    let mut r = x % TWO_PI;
    if r < 0.0 {
        r = r + TWO_PI;
    }
    ret r;
}

// |x| <= pi/2 时的 cos 泰勒展开（12 项：x^24/24! < 1e-19）。
fn cos_taylor(x: f64) -> f64
{
    let x2 = x * x;
    let mut term = 1.0;
    let mut acc = 1.0;
    let mut k = 1;
    while k <= 12
    {
        term = 0.0 - term * x2 / (((2 * k - 1) * (2 * k)) as f64);
        acc = acc + term;
        k = k + 1;
    }
    ret acc;
}

// |x| <= pi/2 时的 sin 泰勒展开。
fn sin_taylor(x: f64) -> f64
{
    let x2 = x * x;
    let mut term = x;
    let mut acc = x;
    let mut k = 1;
    while k <= 12
    {
        term = 0.0 - term * x2 / (((2 * k) * (2 * k + 1)) as f64);
        acc = acc + term;
        k = k + 1;
    }
    ret acc;
}

// 余弦。四象限归约后用泰勒：cos(pi - t) = -cos(t)，cos(t + pi) = -cos(t)，
// cos(2pi - t) = cos(t)。
fn cos(x: f64) -> f64
{
    let r = wrap2pi(x);
    if r < HALF_PI {
        ret cos_taylor(r);
    }
    if r < PI {
        ret 0.0 - cos_taylor(PI - r);
    }
    if r < PI + HALF_PI {
        ret 0.0 - cos_taylor(r - PI);
    }
    ret cos_taylor(TWO_PI - r);
}

// 正弦。sin(pi - t) = sin(t)，sin(t + pi) = -sin(t)，sin(2pi - t) = -sin(t)。
fn sin(x: f64) -> f64
{
    let r = wrap2pi(x);
    if r < HALF_PI {
        ret sin_taylor(r);
    }
    if r < PI {
        ret sin_taylor(PI - r);
    }
    if r < PI + HALF_PI {
        ret 0.0 - sin_taylor(r - PI);
    }
    ret 0.0 - sin_taylor(TWO_PI - r);
}

// 正切（cos 为 0 时结果是 ±inf，与 libm 一致）。
fn tan(x: f64) -> f64
{
    ret sin(x) / cos(x);
}

