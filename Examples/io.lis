//
// io.lis — standard input (compiler builtins) + stdlib breadth helpers.
//
// read_line() reads a line (stripped of its trailing newline) into a shared
// input buffer and returns &i8; read_i32() / read_f64() parse a line into
// i32 / f64. Each read overwrites the shared buffer, so a read_line() result
// is only valid until the next read. Run with piped input:
//     echo "7
// hello" | lisc io.lis

impt math { gcd };
impt chars { is_digit };

impt io { print, println, flush, read_i32, read_i64, read_f64, read_word, read_line, read_rest, try_read_i32, try_read_i64, try_read_f64, try_read_word, try_read_line };
fn main() -> i32
{
    print("enter a number: ");
    let n = read_i32();
    print("double it: ");
    print(n * 2);
    println();

    print("say something: ");
    let line = read_line();
    print("echo: ");
    print(line);
    println();

    print("is_digit('5')=");
    print(is_digit('5'));
    println();
    print("gcd(12,18)=");
    print(gcd(12, 18));
    println();

    ret 0;
}
