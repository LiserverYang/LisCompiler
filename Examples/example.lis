// this is a language-example for lis language to show what this language looks like and some compiler behaviors
// we recommend a new line after function def, and not new line after a control-stream condiction statement
// a non-capital litter with the first letter of a type, that looks nice

fn fib(n: i32) -> i32
{    
    if n == 0 || n == 1 { 
        ret 1;
    }

    ret fib(n - 2) + fib(n - 1);
}

struct number
{
    pub a: i32,
    pub b: i32,
}

impl number
{
    fn new(a: i32, b: i32) -> number
    {
        ret number {
            a: a,
            b: b
        };
    }

    fn add(self: &mut number, a: i32, b: i32)
    {
        self.a = self.a + a;
        self.b = self.b + b;
    }

    fn add_other(self: &mut number, other: &number)
    {
        self.a = self.a + other.a;
        self.b = self.b + other.b;
    }
}

impl Drop for number
{
    fn drop(self) {}
}

fn value<T>(u: T)
{
    ret u;
}

struct box<T>
{
    pub v: T
}

impl box
{
    fn new<T>(_v: T)
    {
        ret box {
            v: _v
        };
    }
}

fn main() -> i32
{
    let x: i32 = fib(4) as i32; // compiler will warn: useless type translating
    
    let mut y: number = number::new(1, 2);

    y.add(x, 2);

    // i64 -> i32 is an ERROR: high-to-low type translating (data may truncate).
    // #[i_know = "message"] before the statement turns the error into a warning.
    let big: i64 = 2147483647 as i64;
    #[i_know = "high-to-low type translating can cause data overflow and other undefined behaviors"]
    let truncated: i32 = big as i32;

    // y is used (borrowed by &mut self) BEFORE it is moved below.
    {
        let z: number = number::new(1, 2);

        y.add_other(&z);

        // compiler will add a z.drop() here
    }

    let m = value(y);

    let u = value(box::new(box::new(10))); // auto type and generic arg determind

    // y; // error: variable m has been moved

    // --- borrow checker: shared vs mutable borrows (NLL) ---
    let mut bc = number::new(1, 2);
    let br = &bc;       // shared borrow of bc
    let bv = br.a;      // read through the shared borrow
    // let bw = &mut bc; // ERROR if uncommented: br is used again below (bv2),
    //                   //   so br's borrow is still live here
    let bv2 = br.a;     // br used again — its borrow stays live through here
    let bw = &mut bc;   // OK: br's borrow ended at bv2 (non-lexical lifetime)
    bw.a = 9;           // mutate through the mutable borrow
    // bc.b = 3;        // ERROR if uncommented: bw is used again below (bwv),
    //                   //   so bw's borrow is still live here
    let bwv = bw.a;     // bw used again — keeps its borrow live to the block end

    ret 0; // compiler will add a y.drop(), m.drop(), u.drop() here
}