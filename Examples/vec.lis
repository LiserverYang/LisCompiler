//
// vec.lis — the standard library's growable array, Vec<T>.
//
//     let mut v = Vec<i32>::new();   // no allocation until the first push
//     v.push(1);  v.push(2);
//     let x = v[0];                  // Index::at     — an out-of-bounds read aborts
//     v[1] = 9;                      // IndexMut::set — an out-of-bounds write aborts
//     let last = v.pop();            // Option<i32>
//     match v.get(99) { ... }        // the checked accessor: none, never aborts
//     for e in v { ... }             // LENDS the Vec: e is &T, the Vec survives
//     for e in move v { ... }        // consumes the Vec (Iterator<T>)
//     v[i] += 1;                     // compound assignment (the place is evaluated once)
//     let x = v.get(i) else 0;       // let ... else: the payload, or a fallback
//
// Elements may own resources (String, another Vec, a struct with a Drop impl):
// the container destroys the elements it still owns -- clear() and the Drop impl
// -- each exactly once. v[i] / v[i] = x / get() hand the element OVER, so they
// exist only for Copy elements; a non-Copy container is read through
// at_ref/at_mut (a lent view) or emptied with pop/remove/for. The buffer grows
// by doubling (0 -> 4 -> 8 -> ...). Everything here COMPILES.

impt vec { Vec };
impt option { Option };
impt string { String };
impt drop { Drop };

// Counts destructor runs, so the non-Copy section below can prove that each
// element is released exactly once.
let drops = 0;

struct Tracked
{
    pub tag: i32
}

impl Drop for Tracked
{
    fn drop(self) { drops = drops + 1; }
}

// A Vec is an ordinary field: it is moved and dropped with the struct that owns
// it, and the buffer goes away with the field.
struct Scores
{
    pub marks: Vec<i32>,
    pub bonus: i32
}

impl Scores
{
    fn new(bonus: i32) -> Scores
    {
        ret Scores { marks: Vec<i32>::new(), bonus: bonus };
    }

    // The buffer is private to Vec, so walking it goes through a lending loop
    // (`for m in self.marks` hands out &i32) rather than a raw pointer. A
    // `while i < len()` loop over `v[i]` is the other option.
    fn total(self: &Scores) -> i32
    {
        let mut s = 0;
        for m in self.marks {
            s = s + *m;
        }
        ret s + self.bonus;
    }
}

fn main() -> i32
{
    // 1. Build. push() grows the buffer when it is full.
    let mut v = Vec<i32>::new();
    let mut i = 0;
    while i < 10 {
        v.push(i * i);
        i = i + 1;
    }
    if v.len() != 10 { ret 1; }
    if v.is_empty() { ret 2; }

    // 2. READ and WRITE through the index operator.
    let mut sum = 0;
    let mut j = 0;
    while j < v.len() {
        sum = sum + v[j];
        j = j + 1;
    }
    if sum != 285 { ret 3; }   // 0 + 1 + 4 + ... + 81
    v[0] = 100;
    if v[0] != 100 { ret 4; }

    // 3. get()/pop() return Option instead of aborting.
    match v.get(99) {
        Some(x) => { ret 5; },
        None => { }
    }
    match v.pop() {
        Some(x) => { if x != 81 { ret 6; } },
        None => { ret 7; }
    }

    // 4. insert()/remove() keep the order; remove() of a bad index is none.
    v.insert(0, 7);
    if v[0] != 7 || v[1] != 100 { ret 8; }
    match v.remove(0) {
        Some(x) => { if x != 7 { ret 9; } },
        None => { ret 10; }
    }

    // 5. As a struct field, and a CONSUMING for-loop over a Vec.
    let mut scores = Scores::new(5);
    scores.marks.push(10);
    scores.marks.push(20);
    if scores.total() != 35 { ret 11; }   // total() walks the field with a lending loop
    let mut seen = 0;
    for m in move scores.marks {   // `move`: consumes the field (Vec implements Iterator<T>)
        seen = seen + m;
    }
    if seen != 30 { ret 12; }

    // 6. clear() empties the length and keeps the capacity.
    let cap = v.cap();
    v.clear();
    if v.len() != 0 { ret 13; }
    if v.cap() != cap { ret 14; }

    // 7. NON-Copy elements. String owns a heap buffer, so the Vec must destroy
    //    every element it still holds -- exactly once.
    {
        let mut names = Vec<String>::new();
        names.push(String::from_lit("ada"));
        names.push(String::from_lit("grace"));
        if names.len() != 2 { ret 15; }
        // at_ref lends a view (no copy, no move); at_mut lends a writable one.
        if names.at_ref(0).len() != 3 { ret 16; }
        let slot = names.at_mut(1);
        *slot = String::from_lit("grace hopper");
        if names.at_ref(1).len() != 12 { ret 17; }
        // pop hands the element over: the caller now owns it.
        match names.pop() {
            Some(s) => { if s.len() != 12 { ret 18; } },
            None => { ret 19; }
        }
        if names.len() != 1 { ret 20; }
    }   // <- the Vec and the String it still owns are destroyed here

    // 8. A user type with a destructor: three elements in, three destructor
    //    runs out (a leak or a double drop would show up as a different count).
    {
        let mut tracked = Vec<Tracked>::new();
        tracked.push(Tracked { tag: 1 });
        tracked.push(Tracked { tag: 2 });
        tracked.push(Tracked { tag: 3 });
        if tracked.at_ref(2).tag != 3 { ret 21; }
        tracked.clear();               // destroys all three
        if drops != 3 { ret 22; }
        // The container is reusable after clear(); the buffer was kept.
        tracked.push(Tracked { tag: 4 });
        if tracked.len() != 1 { ret 23; }
    }
    if drops != 4 { ret 24; }

    // 9. The 2026-09-19 additions: a lending loop, compound assignment and
    //    let ... else. `for e in v` borrows v (e is &i32) instead of draining
    //    it, so the Vec is still there afterwards -- and still growable.
    {
        let mut w = Vec<i32>::new();
        w.push(1);
        w.push(2);
        w.push(3);
        let mut total = 0;
        for e in w {
            total += *e;
        }
        if total != 6 { ret 25; }
        if w.len() != 3 { ret 26; }
        w[0] += 10;
        if w[0] != 11 { ret 27; }
        w.push(4);
        if w.len() != 4 { ret 28; }

        // get() returns Option<i32>: else is the fallback for the miss path.
        let first = w.get(0) else 0 - 1;
        if first != 11 { ret 29; }
        let missing = w.get(99) else 0 - 1;
        if missing != 0 - 1 { ret 30; }
    }

    ret 0;
}
