//
// print.lis — the print builtins + math helpers. The language can now produce
// real output (lowered to libc printf), not just an exit code.

impt math { abs, clamp, max, min };

impt io { print, println, flush, read_i32, read_i64, read_f64, read_word, read_line, read_rest, try_read_i32, try_read_i64, try_read_f64, try_read_word, try_read_line };
fn main() -> i32
{
    print("hello");
    print(' ');
    print("world");
    println();

    print(42);
    println();
    print(3.14);
    println();
    print(true);
    println();

    print("min(3,7)=");
    print(min(3, 7));
    println();
    print("max(3,7)=");
    print(max(3, 7));
    println();
    print("abs(-5)=");
    print(abs(0 - 5));
    println();
    print("clamp(12,0,10)=");
    print(clamp(12, 0, 10));
    println();

    ret 0;
}
