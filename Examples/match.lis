//
// match.lis — enums + pattern matching.
//
// An enum is a tagged union: `color` is all unit variants, `option<T>` carries
// a payload. `match` dispatches on the discriminant and binds the active
// variant's payload. Matching an owned enum consumes it (Rust semantics).

enum color
{
    red,
    green,
    blue
}

enum option<T>
{
    some(T),
    none
}

fn color_to_int(c: color) -> i32
{
    match c {
        red => { ret 0; },
        green => { ret 1; },
        blue => { ret 2; },
    }
}

fn main() -> i32
{
    let c = color::green;
    let a = color_to_int(c);       // 1

    let o = option::some(7);
    match o {
        some(v) => { ret a + v; }, // 1 + 7 = 8
        none => { ret 0; },
    }
}
