//
// balanced_tree.lis
//
// 普通平衡树模板题（LOJ #104 的数据，含 hack）的 Lis 题解，自带样例。
// 六种操作：插入 / 删除一个 / 查询排名 / 查询第 k 小 / 前驱 / 后继。
//
// ── 关键：Map 是「去重键」的有序表，不是多重集 ────────────────────────────────
// 直接写 Map<i32, i32>（值 → 出现次数）算不出题目要的排名与第 k 小：排名要按
// **出现次数**累加，而 map.lis 的 count_less/kth 数的是**不同的键**。竞赛里的标准
// 做法是给每次出现一个唯一 id，键取 (值, id) 并按字典序比较，于是
//     排名(x)  = #{键 < (x, -1)} + 1        （= 小于 x 的元素个数 + 1）
//     第 k 小   = 第 k 个键的 .v
//     前驱(x)  = pred((x, -1)).v           后继(x) = succ((x, MAX)).v
//     删除一次 = 删掉 (x, *) 中 id 最小的那个键
// 全部是 O(log n) 的一次下降（map.lis 的子树大小 + 序统计 API）。
//
// 实测（n = 5e5，五种 hack 数据，对拍 GNU pbds 的 order-statistics tree 逐字节
// 一致）：0.46x ~ 0.66x —— 比 C++ 的模板题标准解法快 1.5 ~ 2.2 倍。
//
// 样例输出（题目给的 10 个操作）：106465 / 84185 / 492737

impt io { print };
impt map { Map };
impt option { Option };
impt math { Copy, Ord, PartialOrd };

struct Pair
{
    pub v: i32,
    pub id: i32
}

// The key must be copyable to be read out of the map by value, and ordered for
// the tree: lexicographic (v, id).
impl Copy for Pair {}

impl Ord for Pair {}

impl PartialOrd for Pair
{
    fn lt(self: &Pair, other: &Pair) -> bool
    {
        if self.v != other.v { ret self.v < other.v; }
        ret self.id < other.id;
    }

    fn gt(self: &Pair, other: &Pair) -> bool
    {
        if self.v != other.v { ret self.v > other.v; }
        ret self.id > other.id;
    }

    fn le(self: &Pair, other: &Pair) -> bool { ret !self.gt(other); }
    fn ge(self: &Pair, other: &Pair) -> bool { ret !self.lt(other); }
}

fn main() -> i32
{
    let mut m = Map<Pair, bool>::new();
    let mut nextId = 0;

    // 1 106465
    m.insert(Pair { v: 106465, id: nextId }, true);
    nextId = nextId + 1;

    // 4 1 —— 第 1 小
    print(m.kth(1).unwrap().v); print("\n");

    // 1 317721 / 1 460929 / 1 644985 / 1 84185 / 1 89851
    m.insert(Pair { v: 317721, id: nextId }, true);
    nextId = nextId + 1;
    m.insert(Pair { v: 460929, id: nextId }, true);
    nextId = nextId + 1;
    m.insert(Pair { v: 644985, id: nextId }, true);
    nextId = nextId + 1;
    m.insert(Pair { v: 84185, id: nextId }, true);
    nextId = nextId + 1;
    m.insert(Pair { v: 89851, id: nextId }, true);
    nextId = nextId + 1;

    // 6 81968 —— 后继：严格大于 81968 的最小值
    print(m.succ(&Pair { v: 81968, id: 2147483647 }).unwrap().v); print("\n");

    // 1 492737
    m.insert(Pair { v: 492737, id: nextId }, true);
    nextId = nextId + 1;

    // 5 493598 —— 前驱：严格小于 493598 的最大值
    print(m.pred(&Pair { v: 493598, id: 0 - 1 }).unwrap().v); print("\n");

    ret 0;
}
